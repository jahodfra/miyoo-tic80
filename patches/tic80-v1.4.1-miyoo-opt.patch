+// [miyoo-opt] Write a screen pixel directly. Equivalent to tic_api_poke4() for screen
+// addresses (the screen is at the start of RAM), without the generic bounds/width dispatch.
+static inline void pokeScreen(tic_core* core, s32 index, u8 color)
+{
+    tic_tool_poke4(core->memory.ram, index, color);
+}
