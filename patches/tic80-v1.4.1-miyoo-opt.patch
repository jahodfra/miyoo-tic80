-    tic_api_poke4((tic_mem*)core, y * TIC80_WIDTH + x, color);
+    pokeScreen(core, y * TIC80_WIDTH + x, color);
+}
+
+// [miyoo-opt] Fill screen pixels [from, to) with one color: whole bytes via memset.
+static inline void fillScreen(tic_core* core, s32 from, s32 to, u8 color)
+{
+    if(from >= to) return;
+    u8* ram = (u8*)core->memory.ram;
+    color &= 0xf;
+    if(from & 1) tic_tool_poke4(ram, from++, color);
+    if(to & 1) tic_tool_poke4(ram, --to, color);
+    if(to > from) memset(ram + (from >> 1), color | (color << 4), (to - from) >> 1);
 }
 
