index a4d0a90..d309062 100644
--- a/src/api/luaapi.c
+++ b/src/api/luaapi.c
@@ -2092,17 +2092,57 @@ void callLuaIntCallback(tic_mem* tic, s32 value, void* data, const char* name)
     }
 }
 
+// [miyoo-opt] The blitter calls SCN/BDR for every row (144x per frame). Looking the globals
+// up each time is costly when a cart doesn't define them (most carts). Row 0 always comes first
+// in a frame, so check there whether they are functions and skip the lookups for that frame.
+static bool luaGlobalIsFunction(tic_mem* tic, const char* name)
+{
+    lua_State* lua = ((tic_core*)tic)->currentVM;
+    if(!lua) return false;
+    lua_getglobal(lua, name);
+    bool is = lua_isfunction(lua, -1);
+    lua_pop(lua, 1);
+    return is;
+}
+
+static struct
+{
+    void* vm;
+    bool scn, oldscn, bdr;
+} LuaCallbacks;
+
 void luaapi_scn(tic_mem* tic, s32 row, void* data)
 {
-    callLuaIntCallback(tic, row, data, SCN_FN);
+    void* vm = ((tic_core*)tic)->currentVM;
+    if(row == 0 || vm != LuaCallbacks.vm)
+    {
+        LuaCallbacks.vm = vm;
+        LuaCallbacks.scn = luaGlobalIsFunction(tic, SCN_FN);
+        LuaCallbacks.oldscn = luaGlobalIsFunction(tic, "scanline");
+        LuaCallbacks.bdr = luaGlobalIsFunction(tic, BDR_FN);
+    }
+
+    if(LuaCallbacks.scn)
+        callLuaIntCallback(tic, row, data, SCN_FN);
 
     // try to call old scanline
-    callLuaIntCallback(tic, row, data, "scanline");
+    if(LuaCallbacks.oldscn)
+        callLuaIntCallback(tic, row, data, "scanline");
 }
 
 void luaapi_bdr(tic_mem* tic, s32 row, void* data)
 {
-    callLuaIntCallback(tic, row, data, BDR_FN);
+    void* vm = ((tic_core*)tic)->currentVM;
+    if(row == 0 || vm != LuaCallbacks.vm)
+    {
+        LuaCallbacks.vm = vm;
+        LuaCallbacks.scn = luaGlobalIsFunction(tic, SCN_FN);
+        LuaCallbacks.oldscn = luaGlobalIsFunction(tic, "scanline");
+        LuaCallbacks.bdr = luaGlobalIsFunction(tic, BDR_FN);
+    }
+
+    if(LuaCallbacks.bdr)
+        callLuaIntCallback(tic, row, data, BDR_FN);
 }
 
